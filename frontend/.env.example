# Copy this file to .env and fill in real values once the backend is ready.

# Optional base URL of the backend API (no trailing slash). Leave blank for
# local development: Vite proxies /api and /auth requests to port 8001.
VITE_API_BASE_URL=

# Set to "true" to use mock data instead of calling the backend.
# Flip to "false" the day the backend is ready — see README "Connecting the backend".
VITE_USE_MOCK_DATA=false
