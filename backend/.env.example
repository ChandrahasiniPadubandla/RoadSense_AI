# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and MUST NOT be committed.

# --- Database (required) ---
# Obtain the PostgreSQL connection string from the project owner / Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Auth (required) ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Chatbot / Groq (optional unless using the chatbot) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Outbound email (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# --- Voice route geocoding (backend only; defaults are fine) ---
# The default provider is Komoot Photon (OpenStreetMap) and needs NO API key.
# GEOCODING_PROVIDER=photon
# GEOCODING_BASE_URL=https://photon.komoot.io/api
# GEOCODING_API_KEY=
# GEOCODING_TIMEOUT_SECONDS=6
# GEOCODING_DEFAULT_CITY=Hyderabad
# GEOCODING_LANGUAGE=en

# --- Voice location NER model (optional) ---
# The model is committed under voice.zip/location_ner_model, so this is only
# needed to point at a custom model directory.
# VOICE_NER_MODEL_PATH=
