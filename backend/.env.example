# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and MUST NOT be committed.

# --- Database (required) ---
# Obtain the team's shared PostgreSQL connection string from the project owner.
# Every teammate must use this same database, not an individual local database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Auth (required) ---
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Chatbot / Groq (optional unless using the chatbot) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Outbound email (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# --- Suggestions (backend only; defaults are shared and require no key) ---
# Suggestions use the fixed Photon/OSM endpoint, English labels, and Hyderabad
# boundary. Provider results are cached in the shared database; no key/settings
# are needed. Do not configure a machine-specific provider URL or boundary.

# --- Voice location NER model (optional) ---
# The model is committed under voice.zip/location_ner_model, so this is only
# needed to point at a custom model directory.
# VOICE_NER_MODEL_PATH=
